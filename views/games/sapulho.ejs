<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link rel="icon" href="https://64.media.tumblr.com/3f7ad0edea8bc95c5efd8e11fa75252f/55f2ba90c4a5fe8e-c9/s500x750/5c40ad8220a01bd3ab43c7ef67f4d3153b8cae5b.gif" type="image/x-icon">
    <title>Sapulho Clicker</title>
        <style>
        .click {position:absolute; width:180px; height:180px; object-fit:contain; left:50%; top:50%; transform:translate(-50%, -50%); cursor:pointer; transition:0.12s; user-select:none}
        .click:hover{ transform:translate(-50%, -50%) scale(1.05)}
        .click:active{transform:translate(-50%, -50%) scale(0.9)}
    </style>
</head>
<body style="background-image: url(https://i.pinimg.com/originals/92/98/b8/9298b8aa90e9bc71a6162878ee24cbeb.gif); background-size: cover;">

    <div style="text-align: center"><br>
        <h3 class="card-title" style="color: white; text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);">Farme pontos!</h3><br>
        <p class="card-text" id="ponto" style="color: white; text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);">0</p>
        <button class="btn btn-primary" style="box-shadow: 2px 2px 4px rgba(0,0,0,0.5);" onclick="up()">Comprar buff: <span id="valor">20</span> pts</button> <br><br>
        <p class="card-text" style="color: white; text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);">Qtde de buffs: <span id="qtd">0</span></p>
        <a href="/games"><button class="btn btn-danger" style="box-shadow: 2px 2px 4px rgba(0,0,0,0.5);">Voltar</button></a>
    </div>
    <div style="display: flex; justify-content: center; align-items: center;">
        <img src="https://64.media.tumblr.com/3f7ad0edea8bc95c5efd8e11fa75252f/55f2ba90c4a5fe8e-c9/s500x750/5c40ad8220a01bd3ab43c7ef67f4d3153b8cae5b.gif" alt="" class="click" onclick="clique()">
    </div>
    <script>
        let ponto = 0;
        let auto = 0;
        let clicar = 1;
        let compra = 20;
        let ativo = false;

        setInterval(()=>{
            if(ativo!=false) { ponto+=auto; atualiza();}
        }, 1000);

        function clique() {ponto+= clicar; atualiza();}

        function up() {
            if(ponto>=compra) {ponto-=compra; auto++;
            compra = Math.floor(compra * 1.5); ativo = true; atualiza(); };
        }

        function atualiza() {
            document.getElementById("ponto").innerHTML = ponto;
            document.getElementById("qtd").innerHTML = auto;
            document.getElementById("valor").innerHTML = compra;

        }
    </script>
</body>
</html>